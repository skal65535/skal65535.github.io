# note: A skip probability of 255 with nothing skipped, and the flag itself
#   written out.
# expect: ok
# exercises: use_skip_proba with a probability that says every macroblock
#   should be skipped while none is, which is the most expensive way to code
#   it.
width 32
height 32
mb_no_skip_coeff 1
prob_skip_false 255
yac_qi 30
macroblock
intra_y_mode DC_PRED
intra_chroma_mode DC_PRED
coeffs y2     -20
coeffs y[0]   1:5 -3 2
coeffs u[1]   4
macroblock count 3
intra_y_mode V_PRED
intra_chroma_mode H_PRED
