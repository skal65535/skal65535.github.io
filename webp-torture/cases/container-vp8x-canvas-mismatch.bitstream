# note: A VP8X canvas of 64x64 in front of a 32x32 frame.
# expect: reject
# roundtrip: no
# exercises: The "Validates image size coherency" check at the end of
#   ParseHeadersInternal(): a VP8X chunk must agree with the frame behind it,
#   in both dimensions. The container is the only place in the format where the
#   picture size is stated twice.
chunks VP8X VP8
canvas_width_minus_one 63
canvas_height_minus_one 63
width 32
height 32
yac_qi 30
macroblock
coeffs y2 -20
coeffs y[6] 1:4 -2
macroblock
intra_y_mode V_PRED
coeffs y2 12
macroblock count 2
