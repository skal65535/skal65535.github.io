# note: Every one of the 1056 coefficient probabilities updated.
# expect: ok
# exercises: The largest partition 0 the corpus has: 1056 set flags, each
#   followed by a raw byte. cwebp updates a handful at most.
width 32
height 32
coeff_prob * * * * 128
yac_qi 30
macroblock
intra_y_mode DC_PRED
intra_chroma_mode DC_PRED
coeffs y2     -20
coeffs y[0]   1:5 -3 2
coeffs u[1]   4
macroblock count 3
intra_y_mode V_PRED
intra_chroma_mode H_PRED
