# note: Horizontal and vertical upscaling hints of 3 (2x) in the top bits of
#   the dimension fields.
# expect: ok
# exercises: pic_hdr->xscale and yscale. libwebp parses and ignores them, so
#   the output stays 32x32; a decoder that honoured them would fail the hash.
width 32
height 32
yac_qi 30
macroblock
intra_y_mode DC_PRED
intra_chroma_mode DC_PRED
coeffs y2     -18
coeffs y[5]   1:3 -2
macroblock count 3
intra_y_mode V_PRED
intra_chroma_mode H_PRED
horizontal_scale 3
vertical_scale 2
