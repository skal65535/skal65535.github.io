# note: Four partitions, the first declaring 16 MB of data.
# expect: reject
# exercises: The "if (psize > size_left) psize = size_left" clamp. Partition
#   0 swallows the rest of the frame, so part_start reaches the end of the
#   buffer and ParsePartitions() returns NOT_ENOUGH_DATA: the frame is refused
#   there, before a single macroblock is decoded.
width 64
height 64
log2_nbr_of_DCT_partitions 2  # 4 partitions
yac_qi 25
macroblock
intra_y_mode DC_PRED
intra_chroma_mode DC_PRED
coeffs y2     20
coeffs y[0]   1:3
macroblock count 3
intra_y_mode DC_PRED
intra_chroma_mode DC_PRED
macroblock
intra_y_mode V_PRED
intra_chroma_mode DC_PRED
coeffs y2     15
coeffs y[1]   1:4
macroblock count 3
intra_y_mode DC_PRED
intra_chroma_mode DC_PRED
macroblock
intra_y_mode H_PRED
intra_chroma_mode DC_PRED
coeffs y2     10
coeffs y[2]   1:5
macroblock count 3
intra_y_mode DC_PRED
intra_chroma_mode DC_PRED
macroblock
intra_y_mode TM_PRED
intra_chroma_mode DC_PRED
coeffs y2     5
coeffs y[3]   1:6
macroblock count 3
intra_y_mode DC_PRED
intra_chroma_mode DC_PRED
patch part_size 0 16777215
