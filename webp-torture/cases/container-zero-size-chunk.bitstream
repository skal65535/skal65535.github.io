# note: An optional chunk declaring a zero-length payload.
# expect: ok
# roundtrip: no
# exercises: disk_chunk_size is then just the 8-byte header, which is the
#   smallest step the walk can take. A zero-length chunk is legal and must be
#   stepped over like any other.
chunks VP8X JUNK VP8
width 32
height 32
yac_qi 30
macroblock
coeffs y2 -20
coeffs y[6] 1:4 -2
macroblock
intra_y_mode V_PRED
coeffs y2 12
macroblock count 2
