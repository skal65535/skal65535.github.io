# note: Four rows over two partitions, so each partition holds two non-
#   adjacent rows.
# expect: ok
# exercises: The "mb_y & num_parts_minus_one" wrap. Each bit reader is left
#   in the middle of a row and resumed two rows later.
width 64
height 64
log2_nbr_of_DCT_partitions 1  # 2 partitions
yac_qi 25
macroblock
intra_y_mode DC_PRED
intra_chroma_mode DC_PRED
coeffs y2     20
coeffs y[0]   1:3
macroblock count 3
intra_y_mode DC_PRED
intra_chroma_mode DC_PRED
macroblock
intra_y_mode V_PRED
intra_chroma_mode DC_PRED
coeffs y2     15
coeffs y[1]   1:4
macroblock count 3
intra_y_mode DC_PRED
intra_chroma_mode DC_PRED
macroblock
intra_y_mode H_PRED
intra_chroma_mode DC_PRED
coeffs y2     10
coeffs y[2]   1:5
macroblock count 3
intra_y_mode DC_PRED
intra_chroma_mode DC_PRED
macroblock
intra_y_mode TM_PRED
intra_chroma_mode DC_PRED
coeffs y2     5
coeffs y[3]   1:6
macroblock count 3
intra_y_mode DC_PRED
intra_chroma_mode DC_PRED
